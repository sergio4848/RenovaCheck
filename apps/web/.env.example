# For running the web app directly on the host (php artisan serve) against the compose
# PostgreSQL/Redis/MinIO. Inside docker compose, values come from the root .env instead.
APP_NAME=RenovaCheck
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000
APP_LOCALE=pl
APP_FALLBACK_LOCALE=en

LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=debug

DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=renova
# Runtime role: owns nothing, cannot bypass row-level security.
DB_USERNAME=renova_app
DB_PASSWORD=renova_app_dev
DB_APP_ROLE=renova_app
# Schema owner, used only by `php artisan migrate|db:seed --database=migrator`.
DB_MIGRATOR_USERNAME=renova_owner
DB_MIGRATOR_PASSWORD=renova_owner_dev

SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
CACHE_STORE=file
QUEUE_CONNECTION=sync

REDIS_CLIENT=predis
REDIS_HOST=127.0.0.1
REDIS_PORT=6379

FILESYSTEM_DISK=local
AWS_ACCESS_KEY_ID=renova
AWS_SECRET_ACCESS_KEY=renova-minio-secret
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=renova-documents
AWS_ENDPOINT=http://127.0.0.1:9000
AWS_USE_PATH_STYLE_ENDPOINT=true

EXTRACT_URL=http://127.0.0.1:8001
EXTRACT_TOKEN=dev-internal-token-change-me

DEMO_USER_PASSWORD=renova-demo
