# Local development defaults. `make env` copies this file to .env and generates APP_KEY.
# Never put production secrets here; .env is git-ignored.

COMPOSE_PROJECT_NAME=renovacheck
# Set to "host" only when image builds must reach a proxy listening on the host's loopback.
COMPOSE_BUILD_NETWORK=default
# Optional path to an already installed apps/web/vendor directory used to seed the web image build.
WEB_VENDOR_SEED=./infra/empty

APP_KEY=
APP_ENV=local
APP_DEBUG=true
APP_URL=http://localhost:8080
WEB_PORT=8080
EXTRACT_PORT=8001

POSTGRES_PORT=5432
POSTGRES_PASSWORD=postgres_dev
RENOVA_OWNER_PASSWORD=renova_owner_dev
RENOVA_APP_PASSWORD=renova_app_dev

MINIO_PORT=9000
# Host the browser uses for signed document URLs (must match how it reaches MinIO).
AWS_PUBLIC_ENDPOINT=http://localhost:9000
# Root account: used only by minio-init to create the bucket and the per-service accounts below.
MINIO_ROOT_USER=renova
MINIO_ROOT_PASSWORD=renova-minio-secret
S3_BUCKET=renova-documents
S3_WEB_ACCESS_KEY=renova-web
S3_WEB_SECRET_KEY=renova-web-secret-dev
S3_EXTRACT_ACCESS_KEY=renova-extract
S3_EXTRACT_SECRET_KEY=renova-extract-secret-dev

# Virus scanning with ClamAV: also start the stack with --profile av.
CLAMAV_ENABLED=false

# development | test | production (production refuses the development secrets above).
RENOVA_ENVIRONMENT=development
# Resource limits for the extraction service container.
EXTRACT_MEM_LIMIT=2g
EXTRACT_CPUS=2

# Shared secret for web -> extract calls.
RENOVA_INTERNAL_TOKEN=dev-internal-token-change-me
# text_layer | tesseract | azure | google
RENOVA_OCR_PROVIDER=tesseract
# Cloud OCR (only used when selected above). Azure: Document Intelligence in Poland Central.
RENOVA_AZURE_DI_ENDPOINT=https://polandcentral.api.cognitive.microsoft.com
RENOVA_AZURE_DI_KEY=
# Google Document AI OCR processor; token from `gcloud auth print-access-token` (expires hourly).
RENOVA_GOOGLE_PROJECT_ID=
RENOVA_GOOGLE_LOCATION=eu
RENOVA_GOOGLE_PROCESSOR_ID=
RENOVA_GOOGLE_ACCESS_TOKEN=
# Optional LLM helper for fields the rules did not find: off | anthropic
# (proposals are kept only when they occur verbatim in the page text).
RENOVA_LLM_PROVIDER=off
RENOVA_LLM_MODEL=claude-sonnet-5-5
RENOVA_ANTHROPIC_API_KEY=

# Password for the seeded demo accounts (see apps/web/database/seeders/DatabaseSeeder.php).
DEMO_USER_PASSWORD=renova-demo
