# Local development defaults. `make env` copies this file to .env and generates APP_KEY.
# Never put production secrets here; .env is git-ignored.

COMPOSE_PROJECT_NAME=renovacheck
# Set to "host" only when image builds must reach a proxy listening on the host's loopback.
COMPOSE_BUILD_NETWORK=default
# Optional path to an already installed apps/web/vendor directory used to seed the web image build.
WEB_VENDOR_SEED=./infra/empty

APP_KEY=
APP_ENV=local
APP_DEBUG=true
APP_URL=http://localhost:8080
WEB_PORT=8080
EXTRACT_PORT=8001

POSTGRES_PORT=5432
POSTGRES_PASSWORD=postgres_dev
RENOVA_OWNER_PASSWORD=renova_owner_dev
RENOVA_APP_PASSWORD=renova_app_dev

MINIO_ROOT_USER=renova
MINIO_ROOT_PASSWORD=renova-minio-secret
S3_BUCKET=renova-documents

# Shared secret for web -> extract calls.
RENOVA_INTERNAL_TOKEN=dev-internal-token-change-me
# text_layer | tesseract | azure | google
RENOVA_OCR_PROVIDER=text_layer
# off | fake | anthropic | openai
RENOVA_LLM_PROVIDER=off

# Password for the seeded demo accounts (see apps/web/database/seeders/DatabaseSeeder.php).
DEMO_USER_PASSWORD=renova-demo
